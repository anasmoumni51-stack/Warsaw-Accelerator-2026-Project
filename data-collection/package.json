{
  "name": "salon-data-collection",
  "version": "1.0.0",
  "description": "Collect, validate, and seed Warsaw salon data from Google Places API",
  "type": "module",
  "scripts": {
    "start": "tsx src/collect.ts && tsx src/validate.ts && tsx src/utils/fetch-photos.ts && tsx src/database/migrate.ts && tsx src/database/seed.ts && tsx test/test-db.ts",
    "migrate": "tsx src/database/migrate.ts",
    "seed": "tsx src/database/seed.ts",
    "collect": "tsx src/collect.ts",
    "validate": "tsx src/validate.ts",
    "photos": "tsx src/utils/fetch-photos.ts",
    "test-db": "tsx test/test-db.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/ test/"
  },
  "dependencies": {
    "@jest/globals": "^30.4.1",
    "cloudinary": "^2.10.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.11",
    "eslint": "^10.4.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
